source "https://rubygems.org"

# Mirrors the GitHub Pages build environment (Jekyll + whitelisted plugins).
# Run locally with: bundle exec jekyll serve
gem "github-pages", group: :jekyll_plugins
gem "webrick"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-paginate"
  gem "jekyll-redirect-from"
end
